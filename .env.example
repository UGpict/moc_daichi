# アプリ独自の設定名。値はコミットしない。未設定項目は doctor が BLOCKED を返す。

# --- 実行プロファイル ---
# DEV（既定）: JSON ストア + 開発用トークン。LIVE 要求時にキー不足でも MOCK へ自動降格しない
# EMULATOR: FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST があるとき
# LIVE: APP_RUNTIME=LIVE。Firebase ID トークン必須。mock トークン拒否
APP_RUNTIME=MOCK

# --- Firebase ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
GOOGLE_APPLICATION_CREDENTIALS=

# --- OrcaRouter（LIVE では必須。未設定なら BLOCKED） ---
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
ORCAROUTER_MUNDANE_MODEL=orcarouter/mundane
ORCAROUTER_HARD_MODEL=orcarouter/hard

# --- Google Maps Platform（Places New / Routes）。LIVE 未設定なら BLOCKED ---
GOOGLE_MAPS_API_KEY=

# --- デモ ---
ENABLE_DEMO_CONTROLS=true
DEMO_ALLOWED_UIDS=
DEMO_AREA_NAME=名古屋駅周辺
DEMO_AREA_ID=area:nagoya-station
DEMO_LAT=35.170915
DEMO_LNG=136.881537
DEMO_DATE=2026-09-19
WORKER_CONCURRENCY=1

# DEV トークン用。LIVE では使わない・既定秘密で認証しない
MOCK_AUTH_SECRET=dev-only-change-me
