# アプリ独自の設定名。値はコミットしない。未設定項目は doctor が BLOCKED を返す。

# --- 実行プロファイル ---
# DEV（既定）: JSON ストア + 開発用トークン。LIVE 要求時にキー不足でも MOCK へ自動降格しない
# EMULATOR: Cloud Agent / 鍵なし確認。Auth+Firestore Emulator。本番へは繋がない
# LIVE: 本物の Firestore。ローカルは `gcloud auth application-default login`
# GOOGLE_APPLICATION_CREDENTIALS は不要。サービスアカウント JSON も不要
APP_RUNTIME=MOCK

# --- Firebase ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# --- OrcaRouter（LIVE では必須。未設定なら BLOCKED） ---
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
# Named Router が未作成なら /v1/models の実在 ID を使う
ORCAROUTER_MUNDANE_MODEL=openai/gpt-4o-mini
ORCAROUTER_HARD_MODEL=openai/gpt-4o

# --- Google Maps Platform（Places New / Routes）。LIVE 未設定なら BLOCKED ---
GOOGLE_MAPS_API_KEY=

# --- デモ ---
ENABLE_DEMO_CONTROLS=true
DEMO_ALLOWED_UIDS=
DEMO_AREA_NAME=名古屋駅周辺
DEMO_AREA_ID=area:nagoya-station
DEMO_LAT=35.170915
DEMO_LNG=136.881537
DEMO_DATE=2026-09-20
WORKER_CONCURRENCY=1
# poller=ローカル常駐 / http=Cloud Run の HTTP ジョブ / sync=同一リクエスト（Vercel） / inline=テスト
WORKER_MODE=
# Cloud Run: Web から Worker サービス（または同一サービス）へ。末尾スラッシュなし
WORKER_INVOKE_URL=
WORKER_SHARED_SECRET=
# 任意。projects/PROJECT/locations/REGION/queues/QUEUE
CLOUD_TASKS_QUEUE=

# AUTO_NOTIFY の送信先。LLM 出力では変更できない
NOTIFY_ALLOWLIST=in-app

# DEV トークン用。LIVE では使わない・既定秘密で認証しない
MOCK_AUTH_SECRET=dev-only-change-me
